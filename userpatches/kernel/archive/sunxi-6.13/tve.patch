 		cpu_thermal {
 			/* milliseconds */
@@ -407,10 +421,14 @@ &display_clocks {
 
 &mbus {
 	compatible = "allwinner,sun8i-h3-mbus";
 };
 
+&mixer1 {
+	resets = <&display_clocks RST_WB>;
+};
+
 &mmc0 {
 	compatible = "allwinner,sun7i-a20-mmc";
 	clocks = <&ccu CLK_BUS_MMC0>,
 		 <&ccu CLK_MMC0>,
 		 <&ccu CLK_MMC0_OUTPUT>,
@@ -454,5 +472,9 @@ &rtc {
 };
 
