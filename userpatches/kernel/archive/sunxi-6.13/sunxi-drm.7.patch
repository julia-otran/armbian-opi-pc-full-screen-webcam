From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Doe <john.doe@somewhere.on.planet>
Date: Thu, 9 Oct 2025 23:16:24 +0000
Subject: Patching kernel sunxi add bws control ioctl

Signed-off-by: John Doe <john.doe@somewhere.on.planet>
---
 drivers/gpu/drm/sun4i/Makefile         |  2 +-
 drivers/gpu/drm/sun4i/sun4i_drv.c      | 19 ++++++
 drivers/gpu/drm/sun4i/sun8i_bws.c      | 32 ++++++++++
 drivers/gpu/drm/sun4i/sun8i_bws.h      | 26 ++++++++
 drivers/gpu/drm/sun4i/sun8i_vi_layer.c |  5 ++
 include/uapi/drm/sun4i_drm.h           | 18 ++++++
 6 files changed, 101 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/sun4i/Makefile b/drivers/gpu/drm/sun4i/Makefile
index a33f7df9d165..9aa12f4a763c
--- a/drivers/gpu/drm/sun4i/Makefile
+++ b/drivers/gpu/drm/sun4i/Makefile
@@ -18,11 +18,12 @@ sun8i-drm-hdmi-y		+= sun8i_hdmi_phy.o
 sun8i-drm-hdmi-y		+= sun8i_hdmi_phy_clk.o
 
 sun8i-mixer-y			+= sun8i_mixer.o sun8i_ui_layer.o \
 				   sun8i_vi_layer.o sun8i_ui_scaler.o \
 				   sun8i_vi_scaler.o sun8i_csc.o \
-				   sun50i_fmt.o sun50i_afbc.o
+				   sun50i_fmt.o sun50i_afbc.o \
+				   sun8i_bws.o
 
 sun4i-tcon-y			+= sun4i_crtc.o
 sun4i-tcon-y			+= sun4i_tcon_dclk.o
 sun4i-tcon-y			+= sun4i_lvds.o
 sun4i-tcon-y			+= sun4i_tcon.o
diff --git a/drivers/gpu/drm/sun4i/sun4i_drv.c b/drivers/gpu/drm/sun4i/sun4i_drv.c
index 269ffb9314b5..9b4deaad45bf
--- a/drivers/gpu/drm/sun4i/sun4i_drv.c
+++ b/drivers/gpu/drm/sun4i/sun4i_drv.c
@@ -33,10 +33,11 @@
 #include "sun4i_tcon.h"
 #include <linux/list.h>
 #include "sun8i_csc.h"
 #include "sunxi_engine.h"
 #include "sun8i_tcon_top.h"
+#include "sun8i_bws.h"
 
 static int drm_sun4i_gem_dumb_create(struct drm_file *file_priv,
 				     struct drm_device *drm,
 				     struct drm_mode_create_dumb *args)
 {
@@ -78,15 +79,33 @@ static int sun4i_set_fcc_params_ioctl(struct drm_device *drm, void *data,
 	}
 
 	return 0;
 }
 
+static int sun8i_set_bws_params_ioctl(struct drm_device *drm, void *data,
+                                      struct drm_file *file_priv)
+{
+	struct drm_sun8i_bws_params *args = data;
+	struct sun4i_drv *drv = drm->dev_private;
+	struct sunxi_engine *engine;
+
+	list_for_each_entry(engine, &drv->engine_list, list) {
+           if (engine->id == 0) {
+	        sun8i_set_bws(engine, args);
+           }
+	}
+
+	return 0;
+}
+
 static const struct drm_ioctl_desc sun4i_drv_ioctls[] = {
 	DRM_IOCTL_DEF_DRV(SUN4I_GEM_CREATE, sun4i_gem_create_ioctl,
 			  DRM_AUTH),
 	DRM_IOCTL_DEF_DRV(SUN4I_SET_FCC_PARAMS, sun4i_set_fcc_params_ioctl,
                           DRM_AUTH),
+	DRM_IOCTL_DEF_DRV(SUN8I_SET_BWS_PARAMS, sun8i_set_bws_params_ioctl,
+                          DRM_AUTH)
 };
 
 static const struct drm_driver sun4i_drv_driver = {
 	.driver_features	= DRIVER_GEM | DRIVER_MODESET | DRIVER_ATOMIC,
 
diff --git a/drivers/gpu/drm/sun4i/sun8i_bws.c b/drivers/gpu/drm/sun4i/sun8i_bws.c
index 000000000000..9c8c033ed1fa
--- /dev/null
+++ b/drivers/gpu/drm/sun4i/sun8i_bws.c
@@ -0,0 +1,32 @@
+#include <drm/sun4i_drm.h>
+#include <uapi/linux/media-bus-format.h>
+
+#include "sunxi_engine.h"
+#include "sun8i_bws.h"
+#include "sun8i_mixer.h"
+
+void sun8i_set_bws(
+	struct sunxi_engine *engine,
+        struct drm_sun8i_bws_params *args)
+{
+	struct regmap *map = engine->regs;
+
+        regmap_write(map, 
+                     SUN8I_BWS_THR0_REG, 
+                     SUN8I_BWS_THR0_VALUE(args->min, args->black) 
+        );
+        regmap_write(map, 
+                     SUN8I_BWS_THR1_REG, 
+                     SUN8I_BWS_THR1_VALUE(args->white, args->max) 
+        );
+        regmap_write(map, 
+                     SUN8I_BWS_SLP0_REG, 
+                     SUN8I_BWS_SLP0_VALUE(args->slope0, args->slope1) 
+        );
+        regmap_write(map, 
+                     SUN8I_BWS_SLP1_REG, 
+                     SUN8I_BWS_SLP1_VALUE(args->slope2, args->slope3) 
+        );
+
+	regmap_write(map, SUN8I_BWS_CTRL_EN_REG, args->enable);
+}
diff --git a/drivers/gpu/drm/sun4i/sun8i_bws.h b/drivers/gpu/drm/sun4i/sun8i_bws.h
index 000000000000..90fc34cc578c
--- /dev/null
+++ b/drivers/gpu/drm/sun4i/sun8i_bws.h
@@ -0,0 +1,26 @@
+#ifndef _SUN8I_BWS_H_
+#define _SUN8I_BWS_H_
+
+#define SUN8I_BWS_CTRL_EN_REG 0xA2000
+
+#define SUN8I_BWS_THR0_REG 0xA2020
+#define SUN8I_BWS_THR0_VALUE(min, black) ((min & 0xFF) | ((black & 0xFF) << 16))
+
+#define SUN8I_BWS_THR1_REG 0xA2024
+#define SUN8I_BWS_THR1_VALUE(white, max) ((white & 0xFF) | ((max & 0xFF) << 16))
+
+#define SUN8I_BWS_SLP0_REG 0xA2028
+#define SUN8I_BWS_SLP0_VALUE(slope0, slope1) ((slope0 & 0b1111111111) | ((slope1 & 0b1111111111) << 16))
+
+#define SUN8I_BWS_SLP1_REG 0xA202C
+#define SUN8I_BWS_SLP1_VALUE(slope2, slope3) ((slope2 & 0b1111111111) | ((slope3 & 0b1111111111) << 16))
+
+struct sunxi_engine;
+struct drm_sun8i_bws_params;
+
+void sun8i_set_bws(
+	struct sunxi_engine *engine,
+        struct drm_sun8i_bws_params *args
+);
+
+#endif
diff --git a/drivers/gpu/drm/sun4i/sun8i_vi_layer.c b/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
index 1294fe9cadb9..a1e6d9712861 100644
--- a/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
@@ -194,10 +194,15 @@ static int sun8i_vi_layer_update_coord(struct sun8i_mixer *mixer, int channel,
 	/* Set FCC Coordinates */
 	regmap_write(mixer->engine.regs, 0xAA004, outsize);
 	regmap_write(mixer->engine.regs, 0xAA008, 0);
 	regmap_write(mixer->engine.regs, 0xAA00c, outsize);
 
+	/* Set BWS Coordinates */
+	regmap_write(mixer->engine.regs, 0xA2004, outsize);
+	regmap_write(mixer->engine.regs, 0xA2008, 0);
+	regmap_write(mixer->engine.regs, 0xA200c, outsize);
+
 	return 0;
 }
 
 static u32 sun8i_vi_layer_get_format_type(const struct drm_format_info *format)
 {
diff --git a/include/uapi/drm/sun4i_drm.h b/include/uapi/drm/sun4i_drm.h
index dcc50ab4ce09..569a5fc4eb38
--- a/include/uapi/drm/sun4i_drm.h
+++ b/include/uapi/drm/sun4i_drm.h
@@ -55,19 +55,37 @@ struct drm_sun4i_fcc_params {
        int hm_sat_gain;
        int hy_hue_gain;
        int hy_sat_gain;
 };
 
+struct drm_sun8i_bws_params {
+	__u8 enable;
+
+	__u8 min;
+	__u8 black;
+	__u8 white;
+	__u8 max;
+
+	__u16 slope0;
+	__u16 slope1;
+	__u16 slope2;
+	__u16 slope3;
+};
+
 #define DRM_SUN4I_GEM_CREATE		0x00
 #define DRM_SUN4I_SET_FCC_PARAMS	0x01
+#define DRM_SUN8I_SET_BWS_PARAMS	0x02
 
 #define DRM_IOCTL_SUN4I_GEM_CREATE	DRM_IOWR(DRM_COMMAND_BASE + DRM_SUN4I_GEM_CREATE, \
 						 struct drm_sun4i_gem_create)
 
 #define DRM_IOCTL_SUN4I_SET_FCC_PARAMS  DRM_IOWR(DRM_COMMAND_BASE + DRM_SUN4I_SET_FCC_PARAMS, \
                                                  struct drm_sun4i_fcc_params)
 
+#define DRM_IOCTL_SUN8I_SET_BWS_PARAMS  DRM_IOWR(DRM_COMMAND_BASE + DRM_SUN8I_SET_BWS_PARAMS, \
+                                                 struct drm_sun8i_bws_params)
+
 #if defined(__cplusplus)
 }
 #endif
 
 #endif
